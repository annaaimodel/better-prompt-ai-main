{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/reference", "destination": "/reference.html" },
    { "source": "/flashcards", "destination": "/flashcards.html" },
    { "source": "/cards", "destination": "/flashcards.html" },
    { "source": "/quiz", "destination": "/quiz.html" },
    { "source": "/exams", "destination": "/quiz.html" },
    { "source": "/tutor", "destination": "/tutor.html" },
    { "source": "/howto", "destination": "/howto.html" },
    { "source": "/how-tos", "destination": "/howto.html" },
    { "source": "/updates", "destination": "/updates.html" }
  ],
  "headers": [
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
